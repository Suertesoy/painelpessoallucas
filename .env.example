NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
# Places API (New) — busca de estabelecimento/endereço no evento presencial.
# Chave SÓ de servidor (nunca NEXT_PUBLIC_*): restrinja no Google Cloud
# Console a "Places API (New)" (Autocomplete (New) + Place Details (New)).
# Sem a chave configurada, a busca de local simplesmente retorna vazio —
# nunca bloqueia a criação do evento.
GOOGLE_PLACES_API_KEY=

# Web Push (Fase 2.2). Par VAPID único do projeto — gere com
# `npx web-push generate-vapid-keys` (ou `webpush.generateVAPIDKeys()`) e
# nunca reutilize entre ambientes/projetos diferentes.
# A chave pública pode chegar ao navegador; a privada é somente servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:seu-email@dominio.com ou a URL HTTPS oficial do app.
VAPID_SUBJECT=

# Aviso de fim de descanso nos Treinos (Upstash QStash, plano Free).
# Console Upstash → QStash → "Request Builder"/"Signing Keys". Somente
# servidor — nunca NEXT_PUBLIC_*. Sem as três, o recurso aparece como "não
# configurado" no app (nunca falha em silêncio). QSTASH_URL só se o console
# mostrar uma URL regional diferente da padrão.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_URL=
